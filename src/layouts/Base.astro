---
import '../styles/global.css';
import { site, practiceAreas } from '../site.config';
import { url, absolute } from '../lib/url';
import { graph, firmSchema, websiteSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string; // canonical path of this page, e.g. "/guides/foo/"
  lang?: 'en' | 'ta';
  alternates?: { en: string; ta: string }; // paths of the EN/TA versions
  schema?: object[];
  type?: 'website' | 'article';
}

const { title, description, path, lang = 'en', alternates, schema = [], type = 'website' } = Astro.props;
const s = Astro.site;
const canonical = absolute(path, s);
const fullTitle = path === '/' || path === '/ta/' ? title : `${title} | ${site.name}`;
const noindex = !site.launched;
const ld = graph(firmSchema(s), websiteSchema(s), ...schema);
const current = Astro.url.pathname;
const isCurrent = (p: string) => (current.startsWith(url(p)) ? 'page' : undefined);
const tel = `tel:${site.phone.replace(/\s+/g, '')}`;
const ta = lang === 'ta';

const nav = ta
  ? [
      { href: '/ta/', label: 'முகப்பு' },
      { href: '/advocates/', label: 'வழக்கறிஞர்கள்' },
      { href: '/practice-areas/', label: 'வழக்கு வகைகள்' },
      { href: '/contact/', label: 'தொடர்புக்கு' },
    ]
  : [
      { href: '/advocates/', label: 'Advocates' },
      { href: '/practice-areas/', label: 'Practice areas' },
      { href: '/guides/', label: 'Legal guides' },
      { href: '/contact/', label: 'Contact' },
    ];
---

<!doctype html>
<html lang={ta ? 'ta-IN' : 'en-IN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en-IN" href={absolute(alternates.en, s)} />
          <link rel="alternate" hreflang="ta-IN" href={absolute(alternates.ta, s)} />
          <link rel="alternate" hreflang="x-default" href={absolute(alternates.en, s)} />
        </>
      )
    }
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ta ? 'ta_IN' : 'en_IN'} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#1b2447" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="text/plain" title="LLM summary" href={url('/llms.txt')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anek+Tamil:wdth,wght@75..125,400..700&family=Source+Serif+4:opsz,wght@8..60,400..600&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">{ta ? 'உள்ளடக்கத்துக்குச் செல்' : 'Skip to content'}</a>
    {
      noindex && (
        <div class="placeholder-banner" role="note">
          Preview. Advocate names and office details are placeholders until the firm confirms them.
        </div>
      )
    }
    <div class="kara" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url(ta ? '/ta/' : '/')}>
          <span class="brand-ta" lang="ta">நம்ம கொங்கு</span>
          <span class="brand-en">Law Associates</span>
        </a>
        <nav class="nav" aria-label={ta ? 'முதன்மை' : 'Main'}>
          {nav.map((n) => <a href={url(n.href)} aria-current={isCurrent(n.href)}>{n.label}</a>)}
          {
            ta ? (
              <a href={url(alternates?.en ?? '/')} lang="en" hreflang="en">English</a>
            ) : (
              <a href={url(alternates?.ta ?? '/ta/')} lang="ta" hreflang="ta">தமிழ்</a>
            )
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="kara" aria-hidden="true"></div>
      <div class="wrap">
        <div>
          <h2>{site.name}</h2>
          <address>
            {site.address.street}, {site.address.locality}<br />
            {site.address.city}, {site.address.district} District<br />
            {site.address.state} {site.address.postalCode}
          </address>
        </div>
        <div>
          <h2>{ta ? 'தொடர்புக்கு' : 'Contact'}</h2>
          <ul>
            <li><a href={tel}>{site.phone}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            {site.hours.map((h) => <li>{ta ? h.daysTa : h.days}, {h.opens} to {h.closes}</li>)}
          </ul>
        </div>
        <div>
          <h2>{ta ? 'வழக்கு வகைகள்' : 'Practice areas'}</h2>
          <ul>
            {
              practiceAreas.map((p) => (
                <li>
                  <a href={url(`/practice-areas/${p.slug}/`)}>{ta ? p.nameTa : p.name}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>{ta ? 'தளம்' : 'This site'}</h2>
          <ul>
            <li><a href={url('/about/')}>{ta ? 'எங்களைப் பற்றி' : 'About the firm'}</a></li>
            <li><a href={url('/guides/')}>{ta ? 'சட்ட வழிகாட்டிகள்' : 'Legal guides'}</a></li>
            <li><a href={url('/disclaimer/')}>{ta ? 'பொறுப்புத் துறப்பு' : 'Disclaimer'}</a></li>
            <li><a href={url('/privacy/')}>{ta ? 'தனியுரிமை' : 'Privacy'}</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap legal">
        <p>
          {
            ta
              ? 'இந்திய வழக்கறிஞர் கவுன்சில் விதிகளின்படி, இந்தத் தளம் தகவலுக்காக மட்டுமே. இது விளம்பரமோ, வழக்கு கோரலோ, சட்ட ஆலோசனையோ அல்ல.'
              : 'In line with the rules of the Bar Council of India, this site is for information only. It is not an advertisement, a solicitation of work, or legal advice, and using it does not create an advocate–client relationship.'
          }
        </p>
      </div>
    </footer>

    <div class="gate" id="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
      <div class="gate-box">
        <div class="kara" aria-hidden="true"></div>
        <div class="inner">
          <h2 id="gate-title">{ta ? 'பொறுப்புத் துறப்பு' : 'Disclaimer'}</h2>
          {
            ta ? (
              <>
                <p>இந்திய வழக்கறிஞர் கவுன்சில் விதிகள், வழக்கறிஞர்கள் விளம்பரம் செய்வதையோ வழக்குகளைக் கோருவதையோ அனுமதிப்பதில்லை. "ஏற்கிறேன்" என்பதை அழுத்துவதன் மூலம் நீங்கள் பின்வருவனவற்றை ஏற்கிறீர்கள்:</p>
                <ul>
                  <li>எங்கள் நிறுவனம் அல்லது உறுப்பினர்களால் எந்த விளம்பரமோ, கோரலோ, தூண்டுதலோ செய்யப்படவில்லை.</li>
                  <li>எங்களைப் பற்றிய தகவலை நீங்களாகவே தேடுகிறீர்கள்.</li>
                  <li>இந்தத் தளத்தில் உள்ளவை பொதுவான தகவல் மட்டுமே; சட்ட ஆலோசனை அல்ல.</li>
                  <li>இந்தத் தளத்தைப் பயன்படுத்துவதால் வழக்கறிஞர்–கட்சிக்காரர் உறவு ஏற்படாது.</li>
                </ul>
              </>
            ) : (
              <>
                <p>The Bar Council of India does not permit advocates to advertise or solicit work. By choosing "I agree" you confirm that:</p>
                <ul>
                  <li>there has been no advertisement, solicitation or inducement of any kind by the firm or its members;</li>
                  <li>you are looking for information about the firm on your own initiative;</li>
                  <li>the material on this site is general information, not legal advice;</li>
                  <li>using this site does not create an advocate–client relationship.</li>
                </ul>
              </>
            )
          }
          <div class="actions">
            <button class="btn btn-solid" id="gate-agree" type="button">{ta ? 'ஏற்கிறேன்' : 'I agree'}</button>
            <a class="btn" href="https://www.google.com/">{ta ? 'வெளியேறு' : 'Leave site'}</a>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var KEY = 'nk-disclaimer-v1';
        var gate = document.getElementById('gate');
        var ok = false;
        try { ok = localStorage.getItem(KEY) === '1'; } catch (e) {}
        if (ok || !gate) return;
        gate.setAttribute('data-open', '');
        document.body.style.overflow = 'hidden';
        var btn = document.getElementById('gate-agree');
        btn.focus();
        btn.addEventListener('click', function () {
          try { localStorage.setItem(KEY, '1'); } catch (e) {}
          gate.removeAttribute('data-open');
          document.body.style.overflow = '';
        });
      })();
    </script>
  </body>
</html>
