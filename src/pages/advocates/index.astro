---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import People from '../../components/People.astro';
import { advocates, site } from '../../site.config';
import { breadcrumbSchema, personSchema } from '../../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Advocates', path: '/advocates/' },
];
---

<Base
  title="Advocates"
  description={`The advocates of ${site.name}, with their enrolment details, qualifications, courts and areas of practice.`}
  path="/advocates/"
  schema={[breadcrumbSchema(crumbs, Astro.site), ...advocates.map((a) => personSchema(a, Astro.site))]}
>
  <Crumbs items={crumbs} />
  <div class="wrap">
    <header class="page-head">
      <h1>Advocates</h1>
      <p>Each advocate is enrolled with the Bar Council of Tamil Nadu and Puducherry.</p>
    </header>
    <People detail />
  </div>
</Base>
