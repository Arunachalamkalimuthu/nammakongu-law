---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import PracticeGrid from '../../components/PracticeGrid.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { site } from '../../site.config';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Practice areas', path: '/practice-areas/' },
];
---

<Base
  title="Practice areas"
  description={`Civil and property, family, criminal, cheque bounce, commercial and consumer matters handled by ${site.name} in Tiruppur, Tamil Nadu.`}
  path="/practice-areas/"
  schema={[breadcrumbSchema(crumbs, Astro.site)]}
>
  <Crumbs items={crumbs} />
  <div class="wrap">
    <header class="page-head">
      <h1>Practice areas</h1>
      <p>The kinds of matters the associates handle, and the laws they arise under.</p>
    </header>
    <PracticeGrid headingLevel="h2" />
  </div>
</Base>
