---
import Base from '../../layouts/Base.astro';
import HomeHero from '../../components/HomeHero.astro';
import Credentials from '../../components/Credentials.astro';
import OfficeCards from '../../components/OfficeCards.astro';
import AreaList from '../../components/AreaList.astro';
import People from '../../components/People.astro';
import { site, advocates } from '../../site.config';
import { faqSchema } from '../../lib/schema';

const team = advocates.filter((a) => !a.name.startsWith('['));
const faq = [
  {
    q: 'காசோலை திரும்பி வந்தால் என்ன செய்ய வேண்டும்?',
    a: 'வங்கியின் திருப்பு அறிக்கை கிடைத்த 30 நாட்களுக்குள் எழுத்து மூலம் கோரிக்கை அறிவிப்பு அனுப்ப வேண்டும். அறிவிப்பு கிடைத்த 15 நாட்களுக்குள் பணம் செலுத்தப்படாவிட்டால், அதன் பின் ஒரு மாதத்திற்குள் மாற்றுமுறை ஆவணச் சட்டம் பிரிவு 138-ன் கீழ் புகார் தாக்கல் செய்யலாம்.',
  },
  {
    q: 'நிலம் வாங்கும் முன் எந்த ஆவணங்களைச் சரிபார்க்க வேண்டும்?',
    a: 'குறைந்தது 30 ஆண்டுகளுக்கான வில்லங்கச் சான்று (EC), விற்பவர் பெயரில் பட்டா, சிட்டா, FMB வரைபடம், அனைத்து மூல ஆவணங்கள், மனைப்பிரிவு அங்கீகாரம் ஆகியவற்றைச் சரிபார்க்க வேண்டும்.',
  },
  {
    q: 'பரஸ்பர சம்மத விவாகரத்துக்கு எவ்வளவு காலம் ஆகும்?',
    a: 'இந்து திருமணச் சட்டம் பிரிவு 13B-ன் கீழ், ஓராண்டு தனித்து வாழ்ந்த தம்பதியர் கூட்டாக மனு தாக்கல் செய்யலாம். முதல் மற்றும் இரண்டாம் மனுக்களுக்கு இடையே ஆறு மாத இடைவெளி உண்டு; தகுந்த சூழலில் நீதிமன்றம் அதைத் தள்ளுபடி செய்யலாம்.',
  },
  {
    q: 'காவல் நிலையத்தில் FIR பதிவு செய்ய மறுத்தால்?',
    a: 'பாரதிய நாகரிக் சுரக்ஷா சன்ஹிதா பிரிவு 173(4)-ன் கீழ் காவல் கண்காணிப்பாளருக்கு எழுத்து மூலம் புகார் அனுப்பலாம். அதன்பின் பிரிவு 175(3)-ன் கீழ் பிரமாணப் பத்திரத்துடன் நீதித்துறை நடுவரிடம் மனு செய்யலாம்.',
  },
];
---

<Base
  title={`${site.nameTa} | திருப்பூர் வழக்கறிஞர்கள்`}
  description={site.descriptionTa}
  path="/ta/"
  lang="ta"
  alternates={{ en: '/', ta: '/ta/' }}
  schema={[faqSchema(faq)]}
>
  <HomeHero lang="ta" />
  <Credentials lang="ta" />

  <section class="section wrap split-section" aria-labelledby="practice">
    <div class="split-head">
      <h2 id="practice">வழக்கு வகைகள்</h2>
      <p>முதல் சட்ட அறிவிப்பு முதல் சென்னை உயர் நீதிமன்ற மேல்முறையீடு வரை.</p>
    </div>
    <AreaList lang="ta" />
  </section>

  <section class="section section-alt offices-band" aria-labelledby="offices">
    <div class="wrap">
      <h2 id="offices">இரண்டு அலுவலகங்கள்</h2>
      <OfficeCards lang="ta" />
    </div>
  </section>

  {
    team.length > 1 && (
  <section class="section section-alt" aria-labelledby="advocates">
    <div class="wrap">
      <div class="section-head">
        <h2 id="advocates">எங்கள் வழக்கறிஞர்கள்</h2>
      </div>
      <People lang="ta" />
    </div>
  </section>
    )
  }

  <section class="section wrap" aria-labelledby="faq-ta">
    <div class="section-head">
      <h2 id="faq-ta">அடிக்கடி கேட்கப்படும் கேள்விகள்</h2>
    </div>
    <div class="faq">
      {
        faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

</Base>
