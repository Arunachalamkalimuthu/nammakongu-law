---
import Base from '../../layouts/Base.astro';
import HeroArt from '../../components/HeroArt.astro';
import Icon from '../../components/Icon.astro';
import PracticeGrid from '../../components/PracticeGrid.astro';
import People from '../../components/People.astro';
import { site } from '../../site.config';
import { url } from '../../lib/url';
import { faqSchema } from '../../lib/schema';

const tel = `tel:${site.phone.replace(/\s+/g, '')}`;
const towns: Record<string, string> = {
  Coimbatore: 'கோயம்புத்தூர்',
  Tiruppur: 'திருப்பூர்',
  Erode: 'ஈரோடு',
  Salem: 'சேலம்',
  Namakkal: 'நாமக்கல்',
  Karur: 'கரூர்',
};
const townsTa = site.areaServed.map((t) => towns[t] ?? t);
const faq = [
  {
    q: 'காசோலை திரும்பி வந்தால் என்ன செய்ய வேண்டும்?',
    a: 'வங்கியின் திருப்பு அறிக்கை கிடைத்த 30 நாட்களுக்குள் எழுத்து மூலம் கோரிக்கை அறிவிப்பு அனுப்ப வேண்டும். அறிவிப்பு கிடைத்த 15 நாட்களுக்குள் பணம் செலுத்தப்படாவிட்டால், அதன் பின் ஒரு மாதத்திற்குள் மாற்றுமுறை ஆவணச் சட்டம் பிரிவு 138-ன் கீழ் புகார் தாக்கல் செய்யலாம்.',
  },
  {
    q: 'நிலம் வாங்கும் முன் எந்த ஆவணங்களைச் சரிபார்க்க வேண்டும்?',
    a: 'குறைந்தது 30 ஆண்டுகளுக்கான வில்லங்கச் சான்று (EC), விற்பவர் பெயரில் பட்டா, சிட்டா, FMB வரைபடம், அனைத்து மூல ஆவணங்கள், மனைப்பிரிவு அங்கீகாரம் ஆகியவற்றைச் சரிபார்க்க வேண்டும்.',
  },
  {
    q: 'பரஸ்பர சம்மத விவாகரத்துக்கு எவ்வளவு காலம் ஆகும்?',
    a: 'இந்து திருமணச் சட்டம் பிரிவு 13B-ன் கீழ், ஓராண்டு தனித்து வாழ்ந்த தம்பதியர் கூட்டாக மனு தாக்கல் செய்யலாம். முதல் மற்றும் இரண்டாம் மனுக்களுக்கு இடையே ஆறு மாத இடைவெளி உண்டு; தகுந்த சூழலில் நீதிமன்றம் அதைத் தள்ளுபடி செய்யலாம்.',
  },
  {
    q: 'காவல் நிலையத்தில் FIR பதிவு செய்ய மறுத்தால்?',
    a: 'பாரதிய நாகரிக் சுரக்ஷா சன்ஹிதா பிரிவு 173(4)-ன் கீழ் காவல் கண்காணிப்பாளருக்கு எழுத்து மூலம் புகார் அனுப்பலாம். அதன்பின் பிரிவு 175(3)-ன் கீழ் பிரமாணப் பத்திரத்துடன் நீதித்துறை நடுவரிடம் மனு செய்யலாம்.',
  },
];
---

<Base
  title={`${site.nameTa} | கொங்கு நாட்டு வழக்கறிஞர்கள்`}
  description={site.descriptionTa}
  path="/ta/"
  lang="ta"
  alternates={{ en: '/', ta: '/ta/' }}
  schema={[faqSchema(faq)]}
>
  <section class="wrap hero">
    <div>
      <h1>கொங்கு நாட்டுக் குடும்பங்களுக்கும் தொழில்களுக்கும் தெளிவான சட்ட உதவி.</h1>
      <p class="hero-lede">
        {site.nameTa}: {townsTa.slice(0, 3).join(', ')} நீதிமன்றங்களிலும் சென்னை உயர் நீதிமன்றத்திலும் சொத்து, குடும்ப,
        குற்றவியல், காசோலை மோசடி மற்றும் வணிக வழக்குகளைக் கையாளும் வழக்கறிஞர்கள் குழு.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={url('/contact/')}>அலுவலகத்தைத் தொடர்பு கொள்ள</a>
        <a class="btn" href={`https://wa.me/${site.whatsapp}`} rel="noopener">
          <Icon name="chat" size={18} /> வாட்ஸ்அப்
        </a>
      </div>
    </div>
    <HeroArt label="கொங்கு நாட்டு நீதிமன்றக் கட்டடம், தென்னை மரங்கள் மற்றும் மலைகளின் ஓவியம்" />
  </section>

  <div class="strip">
    <ul class="wrap">
      <li><Icon name="scales" size={20} /> தமிழ்நாடு மற்றும் புதுச்சேரி வழக்கறிஞர் கவுன்சிலில் பதிவு பெற்றவர்கள்</li>
      <li><Icon name="court" size={20} /> மாவட்ட நீதிமன்றங்கள், சென்னை உயர் நீதிமன்றம்</li>
      <li><Icon name="language" size={20} /> தமிழ், ஆங்கிலம்</li>
      <li><Icon name="clock" size={20} /> {site.hours[0].daysTa}, {site.hours[0].opens}–{site.hours[0].closes}</li>
    </ul>
  </div>

  <section class="section wrap" aria-labelledby="practice">
    <div class="section-head">
      <div>
        <h2 id="practice">வழக்கு வகைகள்</h2>
        <p>முதல் சட்ட அறிவிப்பு முதல் மேல்முறையீடு வரை.</p>
      </div>
    </div>
    <PracticeGrid lang="ta" />
  </section>

  <section class="section section-alt" aria-labelledby="advocates">
    <div class="wrap">
      <div class="section-head">
        <h2 id="advocates">எங்கள் வழக்கறிஞர்கள்</h2>
      </div>
      <People lang="ta" />
    </div>
  </section>

  <section class="section wrap" aria-labelledby="faq-ta">
    <div class="section-head">
      <h2 id="faq-ta">அடிக்கடி கேட்கப்படும் கேள்விகள்</h2>
    </div>
    <div class="faq">
      {
        faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="band" aria-labelledby="talk">
    <div class="wrap">
      <div>
        <h2 id="talk">வழக்கறிஞரிடம் பேசுங்கள்</h2>
        <p>{site.hours[0].daysTa}, {site.hours[0].opens}–{site.hours[0].closes}</p>
      </div>
      <div class="actions">
        <a class="btn" href={tel}><Icon name="phone" size={18} /> {site.phone}</a>
        <a class="btn btn-ghost" href={url('/contact/')}>அலுவலக முகவரி</a>
      </div>
    </div>
  </section>
</Base>
