---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" description="This page does not exist." path="/404/">
  <section class="wrap page-head" style="padding-block:4rem">
    <h1>This page does not exist</h1>
    <p>The link may be old or mistyped. Try the <a href={url('/')}>home page</a> or the <a href={url('/guides/')}>legal guides</a>.</p>
  </section>
</Base>
