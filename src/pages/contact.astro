---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { site } from '../site.config';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
const tel = `tel:${site.phone.replace(/\s+/g, '')}`;
---

<Base
  title="Contact"
  description={`Phone, WhatsApp, email, office address and hours for ${site.name}, ${site.address.city}, Tamil Nadu.`}
  path="/contact/"
  schema={[breadcrumbSchema(crumbs, Astro.site), { '@type': 'ContactPage', name: `Contact ${site.name}` }]}
>
  <Crumbs items={crumbs} />
  <article class="wrap">
    <header class="page-head">
      <h1>Contact</h1>
      <p>Call or send a WhatsApp message to fix a time to meet an advocate. Please bring copies of your documents.</p>
    </header>
    <div class="actions" style="margin-bottom:2.5rem">
      <a class="btn btn-solid" href={tel}>Call {site.phone}</a>
      <a class="btn" href={`https://wa.me/${site.whatsapp}`} rel="noopener">Message on WhatsApp</a>
      <a class="btn" href={`mailto:${site.email}`}>Email {site.email}</a>
    </div>
    <dl class="facts">
      <dt>Address</dt>
      <dd>
        {site.address.street}, {site.address.locality}<br />
        {site.address.city}, {site.address.district} District<br />
        {site.address.state} {site.address.postalCode}
      </dd>
      <dt>Hours</dt>
      <dd>{site.hours.map((h) => `${h.days}, ${h.opens} to ${h.closes}`).join('; ')}</dd>
      <dt>Languages</dt>
      <dd>Tamil, English</dd>
      <dt>Map</dt>
      <dd><a href={site.mapUrl} rel="noopener">Open in Google Maps</a></dd>
    </dl>
    <aside class="note">
      <p>
        Please do not send confidential details of your case by email or WhatsApp before speaking to an advocate.
        Contacting the firm does not by itself create an advocate–client relationship.
      </p>
    </aside>
  </article>
</Base>
