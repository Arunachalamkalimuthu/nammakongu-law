---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
const tel = `tel:${site.phone.replace(/\s+/g, '')}`;
---

<Base
  title="Contact"
  description={`Phone, WhatsApp, email, office address and hours for ${site.name}, ${site.address.city}, Tamil Nadu.`}
  path="/contact/"
  schema={[breadcrumbSchema(crumbs, Astro.site), { '@type': 'ContactPage', name: `Contact ${site.name}` }]}
>
  <Crumbs items={crumbs} />
  <article class="wrap">
    <header class="page-head">
      <h1>Contact</h1>
      <p>Call or send a WhatsApp message to fix a time to meet an advocate. Please bring copies of your documents.</p>
    </header>
    <ul class="contact-list">
      <li>
        <span class="ic"><Icon name="phone" size={20} /></span>
        <span><span class="label">Phone</span><a href={tel}>{site.phone}</a></span>
      </li>
      <li>
        <span class="ic"><Icon name="chat" size={20} /></span>
        <span><span class="label">WhatsApp</span><a href={`https://wa.me/${site.whatsapp}`} rel="noopener">Send a message</a></span>
      </li>
      <li>
        <span class="ic"><Icon name="mail" size={20} /></span>
        <span><span class="label">Email</span><a href={`mailto:${site.email}`}>{site.email}</a></span>
      </li>
      <li>
        <span class="ic"><Icon name="pin" size={20} /></span>
        <span>
          <span class="label">{site.officeLabel}</span>
          {site.address.street}, {site.address.locality}, {site.address.city}, {site.address.district} District, {site.address.state}{' '}
          {site.address.postalCode}<br />
          <a href={site.mapUrl} rel="noopener">Open in Google Maps</a>
        </span>
      </li>
      {
        site.otherOffices.map((o) => (
          <li>
            <span class="ic">
              <Icon name="court" size={20} />
            </span>
            <span>
              <span class="label">{o.label}</span>
              {o.street}, {o.locality}, {o.city}, {o.state} {o.postalCode}
              <br />
              <a href={o.mapUrl} rel="noopener">Open in Google Maps</a>
            </span>
          </li>
        ))
      }
      <li>
        <span class="ic"><Icon name="clock" size={20} /></span>
        <span><span class="label">Hours ({site.address.city})</span>{site.hours.map((h) => `${h.days}, ${h.opens}–${h.closes}`).join('; ')}</span>
      </li>
      <li>
        <span class="ic"><Icon name="language" size={20} /></span>
        <span><span class="label">Languages</span>Tamil, English</span>
      </li>
    </ul>
    <aside class="note">
      <p>
        Please do not send confidential details of your case by email or WhatsApp before speaking to an advocate.
        Contacting the firm does not by itself create an advocate–client relationship.
      </p>
    </aside>
  </article>
</Base>
