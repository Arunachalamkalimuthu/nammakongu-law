---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import Credentials from '../components/Credentials.astro';
import AreaList from '../components/AreaList.astro';
import OfficeCards from '../components/OfficeCards.astro';
import People from '../components/People.astro';
import { site, advocates, practiceAreas } from '../site.config';
import { url } from '../lib/url';

const guides = (await getCollection('guides')).sort((a, b) => +b.data.updated - +a.data.updated);
// Category label for a guide: the first practice area that lists it.
const topic = (id: string) => practiceAreas.find((p) => p.guides.includes(id))?.name.split(' ')[0] ?? 'Guide';
// Show the team section only once there is more than one real advocate.
const team = advocates.filter((a) => !a.name.startsWith('['));
---

<Base
  title={`Adv. ${advocates[0].name}, advocate in ${site.address.city} | ${site.name}`}
  description={site.description}
  path="/"
  alternates={{ en: '/', ta: '/ta/' }}
>
  <HomeHero />
  <Credentials />

  <section class="section wrap split-section" aria-labelledby="practice">
    <div class="split-head">
      <h2 id="practice">Areas of practice</h2>
      <p class="split-head-ta" lang="ta">வழக்கு வகைகள்</p>
      <p>From a first legal notice to appeal before the Madras High Court.</p>
      <a class="more-link" href={url('/practice-areas/')}>All practice areas →</a>
    </div>
    <AreaList />
  </section>

  {
    team.length > 1 && (
      <section class="section section-alt" aria-labelledby="advocates">
        <div class="wrap">
          <div class="section-head">
            <div>
              <h2 id="advocates">Our advocates</h2>
              <p>Each advocate is enrolled with the Bar Council of Tamil Nadu and Puducherry.</p>
            </div>
            <a href={url('/advocates/')}>Meet the team</a>
          </div>
          <People />
        </div>
      </section>
    )
  }

  <section class="section section-alt offices-band" aria-labelledby="offices">
    <div class="wrap">
      <h2 id="offices">Two offices</h2>
      <OfficeCards />
    </div>
  </section>

  <section class="section wrap" aria-labelledby="guides">
    <div class="section-head">
      <h2 id="guides">Legal guides</h2>
      <a href={url('/guides/')}>All guides →</a>
    </div>
    <ul class="guide-row">
      {
        guides.map((g) => (
          <li>
            <span class="guide-topic">{topic(g.id)}</span>
            <a href={url(`/guides/${g.id}/`)}>{g.data.title}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
