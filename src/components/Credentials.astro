---
// Dark credentials band on the home page. Only facts from the Rule 36 schedule:
// enrolment number and date, State Bar Council, qualification, Bar Association
// membership. Unconfirmed [placeholders] are not shown.
import { advocates } from '../site.config';

interface Props {
  lang?: 'en' | 'ta';
}
const { lang = 'en' } = Astro.props;
const ta = lang === 'ta';
const a = advocates[0];
const real = (s: string) => !s.includes('[');
const members = a.memberships.filter(real);

const enrolled = a.enrolledOn
  ? new Date(a.enrolledOn).toLocaleDateString(ta ? 'ta-IN' : 'en-IN', { day: 'numeric', month: 'long', year: 'numeric' })
  : a.enrolledYear;

const items = [
  {
    label: ta ? 'பதிவு எண்' : 'Enrolment',
    value: a.enrolment,
    note: ta ? 'தமிழ்நாடு மற்றும் புதுச்சேரி வழக்கறிஞர் கவுன்சில்' : 'Bar Council of Tamil Nadu and Puducherry',
  },
  {
    label: ta ? 'பதிவு செய்த ஆண்டு' : 'Enrolled',
    value: enrolled,
    note: ta ? `${a.enrolledYear} முதல் வழக்கறிஞர் பணி` : `Practising since ${a.enrolledYear}`,
  },
  {
    label: ta ? 'கல்வித் தகுதி' : 'Qualification',
    value: a.qualifications.join(', '),
    note: a.college ?? '',
  },
  ...(members.length
    ? [{ label: ta ? 'உறுப்பினர்' : 'Member', value: members[0], note: members.slice(1).join(', ') }]
    : []),
];
---

<section class="cred-band" aria-label={ta ? 'பதிவு மற்றும் தகுதி' : 'Enrolment and qualifications'}>
  <dl class="wrap cred-grid" style={`--cols:${items.length}`}>
    {
      items.map((i) => (
        <div>
          <dt>{i.label}</dt>
          <dd class="cred-value">{i.value}</dd>
          {i.note && <dd class="cred-note">{i.note}</dd>}
        </div>
      ))
    }
  </dl>
</section>
