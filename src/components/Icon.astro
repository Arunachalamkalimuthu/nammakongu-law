  'commercial-and-contracts':
    '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5.2A1.2 1.2 0 0 1 10.2 4h3.6A1.2 1.2 0 0 1 15 5.2V7"/><path d="M3 12.5h18"/><path d="M11 12.5v1.5h2v-1.5"/>',
