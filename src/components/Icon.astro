  // facts and contact
  court:
    '<path d="M3 9 12 4l9 5"/><path d="M4 9h16"/><path d="M6 9v8.5M10 9v8.5M14 9v8.5M18 9v8.5"/><path d="M3.5 20h17"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  language:
    '<path d="M3.5 6h9"/><path d="M8 4v2"/><path d="M5.5 6c.4 3.6 2.8 6.4 6 7.5"/><path d="M10.6 6c-.5 3.3-2.6 6-6.1 7.5"/><path d="m13 20 4-9 4 9"/><path d="M14.4 17h5.2"/>',
  scales:
    '<path d="M12 4v16"/><path d="M8 20h8"/><path d="M5 7.5h14"/><path d="m5 7.5-2.5 6a2.5 2.5 0 0 0 5 0z"/><path d="m19 7.5-2.5 6a2.5 2.5 0 0 0 5 0z"/>',
  phone:
    '<path d="M5 4h3.2l1.6 4-2 1.3a10 10 0 0 0 4.9 4.9l1.3-2 4 1.6V17a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  chat: '<path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.4-4A8 8 0 1 1 20 11.5z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
  document:
    '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 12h6M9 16h6"/>',
} as const;

const { name, size = 24, class: cls } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
