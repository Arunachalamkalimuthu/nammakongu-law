---
import { advocates, practiceBySlug } from '../site.config';
import { url } from '../lib/url';

interface Props {
  lang?: 'en' | 'ta';
  detail?: boolean;
}
const { lang = 'en', detail = false } = Astro.props;
const ta = lang === 'ta';
// Initials from the real name; placeholders fall back to a neutral mark.
const initials = (name: string) =>
  name.startsWith('[')
    ? 'NK'
    : name
        .replace(/^(adv\.?|advocate)\s+/i, '')
        .split(/\s+/)
        .filter((w) => /^[A-Za-z]/.test(w))
        .slice(0, 2)
        .map((w) => w[0].toUpperCase())
        .join('');
---

<ul class="people">
  {
    advocates.map((a) => (
      <li class="person">
        <span class="avatar" aria-hidden="true">
          {a.photo ? <img src={url(a.photo)} alt="" width="68" height="68" loading="lazy" /> : initials(a.name)}
        </span>
        <span>
          <a href={url(`/advocates/${a.slug}/`)}>{ta ? a.nameTa : a.name}</a>
          <span class="meta">{a.role}</span>
          <span class="meta">{ta ? 'பதிவு எண்' : 'Enrolment'} {a.enrolment}</span>
          {detail && (
            <span class="meta">
              {a.practiceAreas.map((s) => practiceBySlug(s)?.name).filter(Boolean).join(', ')}
            </span>
          )}
        </span>
      </li>
    ))
  }
</ul>
