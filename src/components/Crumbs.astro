---
import { url } from '../lib/url';
interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol>
    {
      items.map((it, i) =>
        i === items.length - 1 ? (
          <li aria-current="page">{it.name}</li>
        ) : (
          <li>
            <a href={url(it.path)}>{it.name}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
